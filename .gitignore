# ---------------------------------------------------------------------------
# Data — never committed.
# The GIED corpus is distributed via Mendeley Data (DOI 10.17632/zzggrp92vx.2).
# Endoscopic frames carry burned-in acquisition banners before redaction, so
# the raw and intermediate image directories must stay out of version control.
# ---------------------------------------------------------------------------
data/
*.jpg
*.jpeg
*.png
*.tif
*.tiff
*.bmp
*.dcm

# ---------------------------------------------------------------------------
# Everything the pipeline produces.  This repository ships code only: every
# table, figure and checkpoint below is regenerated by running the stages in
# order, so committing them would only risk publishing a stale copy.
# ---------------------------------------------------------------------------
outputs/

*.npy
*.npz
*.pt
*.pth

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
.python-version

# Tooling / test caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# ---------------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Manuscript sources are kept outside this repository
# ---------------------------------------------------------------------------
*.docx
*.doc
*.pdf
~$*
